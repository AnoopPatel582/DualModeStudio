# EmailJS Configuration
# Add these variables to your Vercel project:
# Dashboard → Project → Settings → Environment Variables

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# Admin authentication and database (server-side only)
AUTH_SECRET=generate_a_long_random_secret
MONGODB_URI=add_your_mongodb_url
MONGODB_DB=add_your_db_name

# Cloudinary thumbnail storage (server-side only)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=your_dynamic_asset_folder
